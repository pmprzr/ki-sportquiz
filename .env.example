# Kopie anlegen als .env.local und echte Werte eintragen.
# .env.local wird von Git ignoriert und bleibt nur auf deinem Rechner.
OPENAI_API_KEY=sk-...

# Zufälliges Secret (mind. 32 Zeichen) zum Verschlüsseln der Quiz-Lösungen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QUIZ_SECRET=

# Optional: anderes Modell (Standard: gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini
